# ---- Supabase (Project Settings → API) -------------------------------------
# Server-only. The service-role key bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
# Optional: comma-separated emails allowed to sign in (leave blank = anyone)
AUTH_ALLOWED_EMAILS=

# ---- Resend (magic links + all app email) ------------------------------------
AUTH_RESEND_KEY=
# Must be on a domain you've verified in Resend
EMAIL_FROM=Lindon <studio@yourdomain.com>

# ---- App address (used for links in emails) --------------------------------
# Your live URL, e.g. https://lindon.app (on Vercel this falls back to the production domain)
APP_URL=http://localhost:3107

# ---- Cron (lesson reminders) ------------------------------------------------
# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
